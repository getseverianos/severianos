# ──────────────────────────────────────────────
#  SeverianOS · Sway · Fuligin
#  Your own changes: edit this file, or put *.conf
#  files into ~/.config/sway/config.d/
#  Restore the defaults: sevconfig reset sway
# ──────────────────────────────────────────────
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

# ── Look ──────────────────────────────────────
font pango:JetBrains Mono 10
default_border pixel 2
default_floating_border pixel 2
gaps inner 6
gaps outer 0
smart_borders on
titlebar_padding 8 4
output * bg /usr/share/backgrounds/severian/fuligin.png fill #121214

#                       border   bg       text     indicator child
client.focused          #b5523b  #b5523b  #e6e1d8  #c9a66b   #b5523b
client.focused_inactive #2a292e  #1c1b1f  #8a857c  #2a292e   #2a292e
client.unfocused        #1c1b1f  #1c1b1f  #6f6a62  #1c1b1f   #1c1b1f
client.urgent           #c9a66b  #c9a66b  #121214  #c9a66b   #c9a66b

# ── Input ─────────────────────────────────────
# The keyboard layout lives in /etc/sway/config.d (set by the installer)
# or ~/.config/sway/config.d/keyboard.conf (set by sevkeyboard).
input type:touchpad {
    tap enabled
    natural_scroll enabled
    dwt enabled
}
seat * xcursor_theme Adwaita 24

# ── Basics ────────────────────────────────────
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+b exec sevbrowser
bindsym $mod+Shift+q kill
bindsym $mod+Shift+c reload
bindsym $mod+Escape exec swaylock
bindsym $mod+Shift+e exec sevpower
bindsym $mod+F1 exec foot --app-id sevhelp -W 64x32 sh -c 'sevhelp; read -rsn1'
bindsym $mod+F2 exec sevkeyboard
bindsym $mod+comma exec sevsettings
floating_modifier $mod normal

# ── Focus & move ──────────────────────────────
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# ── Workspaces ────────────────────────────────
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ── Layout ────────────────────────────────────
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle

mode "resize" {
    bindsym $left resize shrink width 20px
    bindsym $down resize grow height 20px
    bindsym $up resize shrink height 20px
    bindsym $right resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# ── Media, brightness, screenshots ────────────
bindsym --locked XF86AudioRaiseVolume exec sevosd volume up
bindsym --locked XF86AudioLowerVolume exec sevosd volume down
bindsym --locked XF86AudioMute exec sevosd volume mute
bindsym --locked XF86AudioMicMute exec sevosd mic mute
bindsym --locked XF86MonBrightnessUp exec sevosd brightness up
bindsym --locked XF86MonBrightnessDown exec sevosd brightness down
bindsym Print exec grim -g "$(slurp -b 12121499 -c b5523bff -w 2)" - | wl-copy
bindsym Shift+Print exec grim - | wl-copy
bindsym $mod+Print exec sevshot
bindsym $mod+Shift+Print exec sevshot full
bindsym $mod+Shift+r exec sevrec

# ── Clipboard, night light, displays, packages ─
bindsym $mod+Shift+v exec sevclip
bindsym $mod+Shift+n exec sevnight toggle
bindsym $mod+Shift+p exec sevdisplay
bindsym $mod+Shift+a exec sevpkg

# ── Window rules ──────────────────────────────
for_window [app_id="sevhelp"] floating enable
for_window [app_id="sevnet"] floating enable
for_window [app_id="sevbt"] floating enable
for_window [app_id="sev-float"] floating enable
for_window [app_id="sevpkg"] floating enable, resize set 900 560
for_window [app_id="polkit-gnome-authentication-agent-1"] floating enable
for_window [app_id="sevupdate"] floating enable, resize set 900 600
for_window [app_id="pavucontrol"] floating enable, resize set 720 480
for_window [app_id="mpv"] floating enable
for_window [app_id="imv"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# ── Bar & services ────────────────────────────
bar {
    swaybar_command waybar
}
exec mako
exec sevidle
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec sevwelcome
exec sevbattery
exec wl-paste --watch cliphist store
exec sevnight restore

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
