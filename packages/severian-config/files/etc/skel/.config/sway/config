# ──────────────────────────────────────────────
#  SeverianOS · Sway · Fuligin
#  Your own changes: edit this file, or put *.conf
#  files into ~/.config/sway/config.d/
#  Restore the defaults: sevconfig reset sway
#
#  Lines starting with ## are read by sevhelp
#  (Super+F1) and have the form
#  ## section | what it does | key label (optional)
# ──────────────────────────────────────────────
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
set $menu fuzzel

# ── Look and input ────────────────────────────
# Colours, fonts, gaps, borders, wallpaper, cursor, touchpad and the keys for
# terminal and browser live in config.d/50-severian.conf, which is generated
# from your settings. Change them with sevsettings or:
#   sevconf set look.accent 7f9a65
# Anything here that is not generated:
smart_borders on
titlebar_padding 8 4

# The keyboard layout lives in /etc/sway/config.d (set by the installer)
# or ~/.config/sway/config.d/keyboard.conf (set by sevkeyboard).

# ── Mouse ─────────────────────────────────────
# Hold Super and drag a window with the left button to move it, with the
# right button to resize it. Tiled windows swap places, floating ones follow
# the pointer.
floating_modifier $mod normal
tiling_drag enable
tiling_drag_threshold 9

# ── Basics ────────────────────────────────────
## start | dropdown terminal (slides in, keeps its session)
bindsym $mod+Mod1+t exec sevdrop

## start | apps
bindsym $mod+d exec $menu

## start | close window
bindsym $mod+q kill
bindsym $mod+Shift+q kill

## start | lock
bindsym $mod+Escape exec swaylock

## start | lock · log out · power
bindsym $mod+Shift+e exec sevpower

## more | reload config
bindsym $mod+Shift+c reload

## more | these shortcuts
bindsym $mod+F1 exec foot --app-id sevhelp -W 76x46 sh -c 'sevhelp; read -rsn1'

## more | keyboard layout
bindsym $mod+F2 exec sevkeyboard

## more | settings
bindsym $mod+comma exec sevsettings

# ── Single-key bindings ───────────────────────
# Ctrl+B for the browser is generated into config.d/50-severian.conf.
# Ctrl+Q and Ctrl+B are taken by Sway before the focused program sees them.
# That is deliberate, but it means Ctrl+Q no longer quits a program by itself
# (an editor cannot ask about unsaved work) and Ctrl+B does not reach tmux,
# nano, emacs or a shell line editor. Put
#   unbindsym Ctrl+q
#   unbindsym Ctrl+b
# into ~/.config/sway/config.d/my-keys.conf to get the keys back.
## start | close window
bindsym Ctrl+q kill


# ── Focus & move ──────────────────────────────
## windows | focus | super + h j k l
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

## windows | move (arrows work too) | super + shift + h j k l
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

## windows | resize | super + ctrl + h j k l
bindsym $mod+Ctrl+$left resize shrink width 40px
bindsym $mod+Ctrl+$down resize grow height 40px
bindsym $mod+Ctrl+$up resize shrink height 40px
bindsym $mod+Ctrl+$right resize grow width 40px
bindsym $mod+Ctrl+Left resize shrink width 40px
bindsym $mod+Ctrl+Down resize grow height 40px
bindsym $mod+Ctrl+Up resize shrink height 40px
bindsym $mod+Ctrl+Right resize grow width 40px

## windows | resize mode
bindsym $mod+r mode "resize"

# ── Put a window away ─────────────────────────
## windows | put the window away
bindsym $mod+Shift+minus move scratchpad

## windows | bring it back (again: away)
bindsym $mod+minus scratchpad show

# ── Workspaces ────────────────────────────────
## workspaces | switch | super + 1…9
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

## workspaces | move window there | super + shift + 1…9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# ── Layout ────────────────────────────────────
## layout | fullscreen
bindsym $mod+space fullscreen
bindsym $mod+f fullscreen

## layout | float
bindsym $mod+Shift+space floating toggle

## layout | tiled ↔ floating
bindsym $mod+Tab focus mode_toggle

## layout | split horizontal / vertical | super + b / v
bindsym $mod+b splith
bindsym $mod+v splitv

## layout | tabs / stack / split | super + w / s / e
bindsym $mod+w layout tabbed
bindsym $mod+s layout stacking
bindsym $mod+e layout toggle split

mode "resize" {
    bindsym $left resize shrink width 20px
    bindsym $down resize grow height 20px
    bindsym $up resize shrink height 20px
    bindsym $right resize grow width 20px
    bindsym Left resize shrink width 20px
    bindsym Down resize grow height 20px
    bindsym Up resize shrink height 20px
    bindsym Right resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

# ── Media, brightness, screenshots ────────────
bindsym --locked XF86AudioRaiseVolume exec sevosd volume up
bindsym --locked XF86AudioLowerVolume exec sevosd volume down
bindsym --locked XF86AudioMute exec sevosd volume mute
bindsym --locked XF86AudioMicMute exec sevosd mic mute
bindsym --locked XF86MonBrightnessUp exec sevosd brightness up
bindsym --locked XF86MonBrightnessDown exec sevosd brightness down

## screen | region → clipboard
bindsym Print exec grim -g "$(slurp -b 12121499 -c b5523bff -w 2)" - | wl-copy

## screen | whole screen → clipboard
bindsym Shift+Print exec grim - | wl-copy

## screen | region → ~/Pictures/Screenshots
bindsym $mod+Print exec sevshot

## screen | whole screen → file
bindsym $mod+Shift+Print exec sevshot full

## screen | record screen (again: stop)
bindsym $mod+Shift+r exec sevrec

# ── Clipboard, night light, displays, packages ─
## more | clipboard history
bindsym $mod+Shift+v exec sevclip

## more | night light on / off
bindsym $mod+Shift+n exec sevnight toggle

## more | displays
bindsym $mod+Shift+p exec sevdisplay

## more | packages
bindsym $mod+Shift+a exec sevpkg

# ── Window rules ──────────────────────────────
for_window [app_id="sevhelp"] floating enable
for_window [app_id="sevnet"] floating enable
for_window [app_id="sevbt"] floating enable
for_window [app_id="sev-float"] floating enable
# sevdrop sets size and position itself, so it can slide in from the top
for_window [app_id="sev-drop"] floating enable, move scratchpad
for_window [app_id="sevpkg"] floating enable, resize set 900 560
for_window [app_id="polkit-gnome-authentication-agent-1"] floating enable
for_window [app_id="sevupdate"] floating enable, resize set 900 600
for_window [app_id="pavucontrol"] floating enable, resize set 720 480
for_window [app_id="mpv"] floating enable
for_window [app_id="imv"] floating enable
for_window [window_role="pop-up"] floating enable
for_window [window_type="dialog"] floating enable

# ── Bar & services ────────────────────────────
bar {
    swaybar_command waybar
}
exec mako
exec sevidle
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
exec sevwelcome
exec sevbattery
exec wl-paste --watch cliphist store
exec sevnight restore

include /etc/sway/config.d/*
include ~/.config/sway/config.d/*
