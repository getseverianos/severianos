# SeverianOS · mako · Fuligin
font={{look.font}} {{look.font_size}}
background-color=#{{look.bg}}
text-color=#{{look.text}}
border-color=#{{look.accent}}
border-size={{look.border}}
border-radius={{look.radius}}
padding=12
margin=10
width=340
default-timeout=6000
format=<b>%s</b>\n%b

[urgency=low]
border-color=#{{look.muted2}}

[urgency=critical]
border-color=#{{look.gold}}
default-timeout=0

[app-name=SeverianOS]
default-timeout=12000

[app-name=sevosd]
format=%s
border-color=#{{look.surface2}}
progress-color=over #{{look.accent}}
default-timeout=1200
