# SeverianOS · swaynag · Fuligin
font={{look.font}} {{look.font_size}}

[warning]
background={{look.bg}}
border={{look.accent}}
border-bottom={{look.accent}}
button-background={{look.surface}}
text={{look.text}}
button-text={{look.text_bright}}

[error]
background={{look.bg}}
border={{look.accent}}
border-bottom={{look.accent}}
button-background={{look.surface}}
text={{look.text}}
button-text={{look.text_bright}}
