ring-ver-color={{look.gold}}
ring-wrong-color={{look.accent}}
key-hl-color={{look.accent}}
bs-hl-color={{look.muted}}
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color={{look.text}}
text-clear-color={{look.muted}}
text-ver-color={{look.gold}}
text-wrong-color={{look.accent}}
