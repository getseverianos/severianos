[Desktop Entry]
Type=Application
Name=Browser
GenericName=Web Browser
Comment=Browse the web – Firefox without telemetry
Icon=firefox
Exec=sevbrowser %u
Terminal=false
StartupWMClass=firefox
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/pdf;
Actions=new-window;private-window;

[Desktop Action new-window]
Name=New Window
Exec=sevbrowser --new-window %u

[Desktop Action private-window]
Name=New Private Window
Exec=sevbrowser --private-window %u
