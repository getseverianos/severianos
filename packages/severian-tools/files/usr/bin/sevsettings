#!/usr/bin/env bash
# sevsettings — one menu for the everyday settings of SeverianOS.
# Uses fuzzel for choices and foot for tools that need a terminal.
# Everything that must survive a restart goes through sevconf, which writes
#   ~/.config/severian/user.toml
# and generates the config files from it.
set -uo pipefail

SWAYD=${XDG_CONFIG_HOME:-$HOME/.config}/sway/config.d
SWAYF=$SWAYD/90-sevsettings.conf

pick() {  # $1 prompt, choices on stdin
    fuzzel --dmenu --prompt "● $1  " --lines 12 --width 40
}
say() { notify-send -a SeverianOS "Settings" "$1" 2>/dev/null || echo "$1"; }
term() { exec foot --app-id sev-float -W 80x24 "$@"; }
has() { command -v "$1" >/dev/null; }

# --- sections ------------------------------------------------------------
network() { exec foot --app-id sevnet -W 80x24 nmtui; }

bluetooth() { exec foot --app-id sevbt -W 90x26 bluetui; }

sound() {
    has wpctl || { say "wpctl (wireplumber) not found"; return; }
    local sec sinks line id
    sec=$(printf '%s\n' "Output device" "Input device" "Volume" | pick Sound) || return
    case $sec in
        Volume)
            local v; v=$(printf '%s\n' 100 75 50 25 0 | pick "Volume %") || return
            wpctl set-volume @DEFAULT_AUDIO_SINK@ "$v%"; return ;;
        "Output device") sinks=Sinks ;;
        "Input device")  sinks=Sources ;;
    esac
    line=$(wpctl status | awk -v s="$sinks:" '
        /Audio/ {a=1} /Video/ {a=0}
        a && $0 ~ s {on=1; next}
        on && /^ *│ *$/ {exit}
        on && /[0-9]+\./ {sub(/^[ │├└─*]+/,""); print}' | pick "$sec") || return
    id=${line%%.*}; id=${id//[^0-9]/}
    [[ -n $id ]] && wpctl set-default "$id" && say "default: ${line#*. }"
}

display() { exec sevdisplay; }

keyboard() { exec sevkeyboard; }

# older versions kept touchpad lines in 90-sevsettings.conf, which loads after
# the generated file and would win – drop them when we touch this menu
unpersist() { [[ -f $SWAYF ]] && sed -i -e "/^# sev:$1\$/,+1d" -e "/ # sev:$1\$/d" "$SWAYF"; }

touchpad() {
    local c
    c=$(printf '%s\n' "Tap to click on" "Tap to click off" "Natural scroll on" "Natural scroll off" | pick Touchpad) || return
    unpersist tap; unpersist nat
    case $c in
        "Tap to click on")    sevconf set input.touchpad.tap enabled >/dev/null; say "tap to click: on" ;;
        "Tap to click off")   sevconf set input.touchpad.tap disabled >/dev/null; say "tap to click: off" ;;
        "Natural scroll on")  sevconf set input.touchpad.natural_scroll enabled >/dev/null; say "natural scroll: on" ;;
        "Natural scroll off") sevconf set input.touchpad.natural_scroll disabled >/dev/null; say "natural scroll: off" ;;
    esac
}

appearance() {
    local sec v
    sec=$(printf '%s\n' "Accent colour" "Font size" "Gaps" "Bar position" | pick Appearance) || return
    case $sec in
        "Accent colour")
            v=$(printf '%s\n' "ember b5523b" "green 7f9a65" "gold c9a66b" "blue 6b8299" "violet 9a7aa0" | pick Accent) || return
            sevconf set look.accent "${v##* }" >/dev/null && say "accent: ${v%% *}" ;;
        "Font size")
            v=$(printf '%s\n' 9 10 11 12 14 | pick "Font size") || return
            sevconf set look.font_size "$v" >/dev/null && say "font size: $v (terminals already open keep theirs)" ;;
        Gaps)
            v=$(printf '%s\n' 0 4 6 8 12 | pick "Gap between windows") || return
            sevconf set look.gaps "$v" >/dev/null && say "gaps: $v" ;;
        "Bar position")
            v=$(printf '%s\n' top bottom | pick "Bar position") || return
            sevconf set bar.position "$v" >/dev/null && say "bar: $v" ;;
    esac
}

all_settings() { exec foot --app-id sev-float -W 100x40 sh -c 'sevconf list; echo; printf "  change one: sevconf set KEY VALUE   ·  edit the file: sevconf edit\n\n  press any key"; read -rsn1'; }

power() {
    if has powerprofilesctl; then
        local p; p=$(powerprofilesctl list | awk -F: '/^[ *]+[a-z-]+:$/ {gsub(/[ *]/,"",$1); print $1}' | pick "Power profile") || return
        powerprofilesctl set "$p" && say "power: $p"
    else
        say "power-profiles-daemon is not installed"
    fi
}

apps() {  # desktop files whose name matches $1
    local f
    for f in /usr/share/applications/*.desktop; do
        [[ ${f##*/} =~ $1 ]] && echo "${f##*/}"
    done
}

defaults() {
    local kind app
    shopt -s nocasematch
    kind=$(printf '%s\n' "Web browser" "File manager" "Image viewer" "Video player" | pick "Default app") || return
    case $kind in
        "Web browser")  app=$(apps '(firefox|chrom|brave|qutebrowser|librewolf)' | pick Browser) || return
                        xdg-settings set default-web-browser "$app" ;;
        "File manager") app=$(apps '(thunar|nautilus|pcmanfm|dolphin|nemo)' | pick "File manager") || return
                        xdg-mime default "$app" inode/directory ;;
        "Image viewer") app=$(apps '(imv|eog|feh|gwenview|loupe)' | pick Images) || return
                        xdg-mime default "$app" image/png image/jpeg image/webp image/gif ;;
        "Video player") app=$(apps '(mpv|vlc|celluloid)' | pick Video) || return
                        xdg-mime default "$app" video/mp4 video/x-matroska video/webm ;;
    esac
    say "$kind: ${app%.desktop}"
}

night() {
    local m
    m=$(printf '%s\n' "auto (20:00–07:00)" always off | pick "Night light") || return
    sevnight "${m%% *}"
}

clipboard() {
    case $(printf '%s\n' "show history" "clear history" | pick Clipboard) in
        "show history")  exec sevclip ;;
        "clear history") cliphist wipe && say "clipboard history cleared" ;;
    esac
}

mascot() {
    case $(printf '%s\n' on off | pick "Ember mascot") in
        on)  sev mascot on  >/dev/null; say "the ember is back" ;;
        off) sev mascot off >/dev/null; say "the ember rests" ;;
    esac
}

about() { term sh -c 'sevfetch; echo; sev; read -rsn1'; }

reset() {
    [[ $(printf '%s\n' "No" "Yes, reset my config" | pick "Reset to SeverianOS defaults?") == Yes* ]] || return
    term bash -c 'sevconfig reset; read -rp "done - press Enter"'
}

# --- main ----------------------------------------------------------------
sections=(appearance network bluetooth sound display "night light" keyboard touchpad power clipboard packages "default apps" ember update "all settings" about reset)
choice=$(printf '%s\n' "${sections[@]}" | pick settings) || exit 0
case $choice in
    appearance) appearance ;; "all settings") all_settings ;;
    network) network ;; bluetooth) bluetooth ;; sound) sound ;; display) display ;;
    "night light") night ;; clipboard) clipboard ;; packages) exec sevpkg ;;
    keyboard) keyboard ;; touchpad) touchpad ;; power) power ;; "default apps") defaults ;;
    ember) mascot ;; update) exec foot --app-id sevupdate sevupdate --wait ;;
    about) about ;; reset) reset ;;
esac
