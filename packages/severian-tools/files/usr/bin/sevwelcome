#!/usr/bin/env bash
# sevwelcome — greet the user once (on the live medium: every session)

state=${XDG_STATE_HOME:-$HOME/.local/state}/severian
live=0; [[ -d /run/archiso ]] && live=1

# Once per user: tell GTK 4 / portal-aware apps (Firefox too) to prefer dark
if [[ ! -e $state/theme && -n ${WAYLAND_DISPLAY:-} ]] && command -v gsettings >/dev/null; then
    mkdir -p "$state"
    gsettings set org.gnome.desktop.interface color-scheme 'prefer-dark' 2>/dev/null
    gsettings set org.gnome.desktop.interface gtk-theme 'Adwaita-dark' 2>/dev/null
    gsettings set org.gnome.desktop.interface icon-theme 'Adwaita' 2>/dev/null
    gsettings set org.gnome.desktop.interface cursor-theme 'Adwaita' 2>/dev/null
    gsettings set org.gnome.desktop.interface font-name 'Noto Sans 10' 2>/dev/null
    touch "$state/theme"
fi

[[ -e $state/welcomed && $live -eq 0 ]] && exit 0
mkdir -p "$state" && touch "$state/welcomed"

sleep 2
body=$'super + enter   terminal\nsuper + d       apps\nsuper + f1      all shortcuts'
(( live )) && body+=$'\n\nto install: super + d → Install SeverianOS'
notify-send -a SeverianOS "Welcome to SeverianOS" "$body"
