#!/usr/bin/env bash
# sevosd — change volume, brightness or playback and show it (via mako)
#   sevosd volume up|down|mute     sevosd mic mute     sevosd brightness up|down
#   sevosd media play|next|prev|stop

show() {  # $1 title, $2 value 0-100
    notify-send -a sevosd -t 1200 \
        -h string:x-canonical-private-synchronous:sevosd -h "int:value:$2" "$1" 2>/dev/null
}

text() {  # $1 title, $2 body – for things that have no bar
    notify-send -a sevosd -t 1600 \
        -h string:x-canonical-private-synchronous:sevosd "$1" "${2:-}" 2>/dev/null
}

# What is playing, as "artist — title". Empty when nothing is playing.
track() {
    local t
    t=$(playerctl metadata --format '{{ artist }} — {{ title }}' 2>/dev/null) || return 0
    t=${t# — }; t=${t% — }
    printf '%s' "$t"
}

case ${1:-}:${2:-} in
    volume:up)   wpctl set-mute @DEFAULT_AUDIO_SINK@ 0; wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    volume:down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    volume:mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
    mic:mute)    wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle ;;
    brightness:up)   brightnessctl -q set 5%+ ;;
    brightness:down) brightnessctl -q set 5%- ;;
    media:*)
        command -v playerctl >/dev/null || { text "no player control" "install playerctl"; exit 1; }
        case $2 in
            play|pause|play-pause|toggle) playerctl play-pause 2>/dev/null ;;
            next)                         playerctl next 2>/dev/null ;;
            prev|previous)                playerctl previous 2>/dev/null ;;
            stop)                         playerctl stop 2>/dev/null ;;
            *) echo "usage: sevosd media play|next|prev|stop" >&2; exit 1 ;;
        esac
        # the player needs a moment before it reports the new state
        sleep 0.25
        case $(playerctl status 2>/dev/null) in
            Playing) text "playing" "$(track)" ;;
            Paused)  text "paused"  "$(track)" ;;
            *)       text "stopped" ;;
        esac
        exit 0 ;;
    *) echo "usage: sevosd volume up|down|mute | mic mute | brightness up|down | media play|next|prev|stop" >&2; exit 1 ;;
esac

case $1 in
    volume|mic)
        dev=@DEFAULT_AUDIO_SINK@; name=volume
        [[ $1 == mic ]] && { dev=@DEFAULT_AUDIO_SOURCE@; name=microphone; }
        read -r _ v rest < <(wpctl get-volume "$dev")
        pct=$(awk -v v="$v" 'BEGIN {printf "%d", v * 100 + 0.5}')
        if [[ $rest == *MUTED* ]]; then show "$name muted" 0; else show "$name $pct%" "$pct"; fi ;;
    brightness)
        pct=$(brightnessctl -m | awk -F, '{gsub("%", "", $4); print $4}')
        show "brightness $pct%" "$pct" ;;
esac
pkill -RTMIN+8 waybar 2>/dev/null || true
