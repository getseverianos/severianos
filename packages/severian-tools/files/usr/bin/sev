#!/usr/bin/env bash
# sev — the ember of SeverianOS. Shows how the system is doing and
# leads to the other sev* tools. Runs only when called, no daemon.
set -uo pipefail

CONF=${XDG_CONFIG_HOME:-$HOME/.config}/sev/settings
MASCOT=1
if [[ -f $CONF ]] && grep -qx 'mascot=off' "$CONF"; then MASCOT=0; fi

if [[ -t 1 ]]; then
    E=$'\e[38;2;181;82;59m' B=$'\e[38;2;201;166;107m' M=$'\e[38;2;111;106;98m' R=$'\e[0m'
else
    E='' B='' M='' R=''
fi

# --- state -------------------------------------------------------------
failed_units() {
    { systemctl --failed --plain --no-legend 2>/dev/null
      systemctl --user --failed --plain --no-legend 2>/dev/null; } | awk 'NF{print $1}'
}
root_use() { df --output=pcent / 2>/dev/null | tail -n1 | tr -dc 0-9; }
update_count() {
    command -v checkupdates >/dev/null || { echo "?"; return; }
    local n
    n=$(checkupdates 2>/dev/null | wc -l) || n=0
    echo "$n"
}

# mood: calm | awake | worried, plus one line of text
mood() {
    local failed use upd
    failed=$(failed_units | wc -l)
    use=$(root_use); use=${use:-0}
    upd=$(update_count)
    MSG=()
    MOOD=calm
    if ((failed > 0)); then MOOD=worried; MSG+=("$failed failed service(s) - run: sev doctor"); fi
    if ((use >= 90)); then MOOD=worried; MSG+=("disk ${use}% full"); fi
    if [[ $upd =~ ^[0-9]+$ ]] && ((upd > 0)); then
        [[ $MOOD == calm ]] && MOOD=awake
        MSG+=("$upd update(s) ready - run: sev update")
    fi
    ((${#MSG[@]})) || MSG=("all quiet. the old sun still burns.")
}

face() {
    case $1 in
        calm)    echo "-  -" ;;
        awake)   echo "o  o" ;;
        worried) echo "°  °" ;;
        happy)   echo "^  ^" ;;
    esac
}

draw() {  # $1 mood, rest = lines of text
    local f l
    f=$(face "$1"); shift
    if ((MASCOT)); then
        printf '%s     .  %s\n' "$E" "$R"
        printf '%s   .(%s)  %s%s\n' "$E" "$f" "$R" "${1:-}"
        printf '%s    (____)  %s%s\n' "$E" "$R" "${2:-}"
        printf '%s  ‾‾‾‾‾‾‾‾‾‾%s %s%s\n' "$B" "$R" "$M" "${3:-}$R"
        shift 3 2>/dev/null || shift $#
    fi
    for l in "$@"; do echo "$l"; done
}

status() {
    mood
    local up
    up=$(uptime -p 2>/dev/null | sed 's/^up //')
    draw "$MOOD" "${MSG[@]:0:2}" "up ${up:-?}" "${MSG[@]:2}"
}

# --- waybar --------------------------------------------------------------
json_escape() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; printf '%s' "$s"; }
waybar() {
    mood
    local tip
    tip=$(printf '%s\n' "${MSG[@]}")
    printf '{"text":"●","class":"%s","tooltip":"%s"}\n' "$MOOD" "$(json_escape "$tip")"
}

# --- menu ----------------------------------------------------------------
menu() {
    local pick
    pick=$(printf '%s\n' settings update doctor keys power |
        fuzzel --dmenu --prompt '● ' --lines 5 --width 16) || exit 0
    case $pick in
        settings) exec sevsettings ;;
        update)   exec foot --app-id sevupdate sevupdate --wait ;;
        doctor)   exec foot --app-id sev-float -W 80x24 sh -c 'sev doctor; read -rsn1' ;;
        keys)     exec foot --app-id sevhelp -W 64x32 sh -c 'sevhelp; read -rsn1' ;;
        power)    exec sevpower ;;
    esac
}

run_or_say() { if command -v "$1" >/dev/null; then exec "$@"; else echo "sev: $1 is not installed" >&2; exit 1; fi; }

doctor() {
    if command -v sevdoctor >/dev/null; then exec sevdoctor "$@"; fi
    mood
    draw "$MOOD" "${MSG[@]}"
    local u; u=$(failed_units)
    [[ -n $u ]] && { echo; echo "failed:"; sed 's/^/  /' <<<"$u"; }
    local pn; pn=$(find /etc -name '*.pacnew' 2>/dev/null)
    [[ -n $pn ]] && { echo; echo ".pacnew files to merge:"; sed 's/^/  /' <<<"$pn"; }
    return 0
}

usage() {
    cat <<EOF
usage: sev [command]
  (none)     how the system is doing
  update     update the system (sevupdate)
  doctor     look for problems
  settings   open the settings menu
  help       key bindings (sevhelp)
  menu       quick menu (also: right click on the ember in waybar)
  pet        say hello
  mascot on|off
EOF
}

case ${1:-} in
    "")        status ;;
    update)    shift; run_or_say sevupdate "$@" ;;
    doctor)    shift; doctor "$@" ;;
    settings)  exec sevsettings ;;
    help|keys) run_or_say sevhelp ;;
    menu)      menu ;;
    waybar)    waybar ;;
    pet)       draw happy "*glows a little brighter*" ;;
    mascot)
        mkdir -p "${CONF%/*}"; touch "$CONF"
        case ${2:-} in
            on|off) sed -i '/^mascot=/d' "$CONF"; echo "mascot=$2" >>"$CONF"; echo "mascot $2" ;;
            *) usage; exit 1 ;;
        esac ;;
    -h|--help) usage ;;
    *) usage; exit 1 ;;
esac
